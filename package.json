{
  "name": "detective-game",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "next build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "models": "tsx scripts/list-models.ts",
    "tunnel": "node scripts/tunnel.mjs",
    "tunnel:ngrok": "node scripts/tunnel.mjs ngrok",
    "voice:check": "tsx scripts/voice-check.ts",
    "setup:elevenlabs": "node scripts/setup-elevenlabs-secret.mjs",
    "demo": "REQUIRE_NEBIUS=1 tsx server/index.ts",
    "preflight": "tsx scripts/preflight.ts",
    "setup:agent": "tsx scripts/setup-elevenlabs-agent.ts",
    "difficulty": "tsx scripts/evidence-only-check.ts"
  },
  "dependencies": {
    "@elevenlabs/react": "^1.15.2",
    "next": "14.2",
    "openai": "^4.104.0",
    "qrcode": "^1.5.4",
    "react": "18.3",
    "react-dom": "18.3",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
