# Copy to .env.local and fill in. All of these are SERVER-ONLY: never give a secret a
# NEXT_PUBLIC_, VITE_ or REACT_APP_ prefix (that would ship it to every phone).

# --- Required ---
# Nebius Token Factory key. Without it the game runs on an offline MOCK detective (loud warnings everywhere).
NEBIUS_API_KEY=
# ElevenLabs API key: the full secret key shown once when you create or rotate a key (Settings > API Keys),
# not the key's ID. Needs access to Agents (Conversational AI). Without a working key, players type answers.
ELEVENLABS_API_KEY=
# The Conversational AI agent that voices each turn. Create it with `npm run setup:agent` (it saves this for you).
# Without it the game falls back to the recorder + text-to-speech mode.
ELEVENLABS_AGENT_ID=

# --- Optional ---
# Your HTTPS tunnel URL (e.g. https://xyz.trycloudflare.com). Overrides the URL used in the join QR code.
PUBLIC_URL=
# Detective voice (an ElevenLabs voice ID). Defaults to a built-in voice.
ELEVENLABS_DETECTIVE_VOICE_ID=
# Override the Nebius models without editing code (see `npm run preflight` / `npm run models`).
NEBIUS_MODEL_EXTRACT=
NEBIUS_MODEL_EXTRACT_FALLBACK=
NEBIUS_MODEL_REASONING=
NEBIUS_MODEL_REASONING_FALLBACK=

# --- Developer switches ---
# mock forces the offline mock detective even when NEBIUS_API_KEY is set
LLM_PROVIDER=
# 1 = refuse to start on the mock (the `npm run demo` script sets this)
REQUIRE_NEBIUS=
# 1 = show raw game state on the host screen (development only, never in a real game)
DEBUG_HOST=

# --- Written by `npm run setup:elevenlabs` (only needed for `npm run setup:agent -- --nebius-llm`) ---
# ID of the ElevenLabs Workspace Secret holding the Nebius key. An identifier, not a credential.
ELEVENLABS_NEBIUS_SECRET_ID=
